{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Dev Script",
      "runtimeArgs": [
        "-r",
        "ts-node/register"
      ],
      "args": [
        "${workspaceFolder}/debug/index.ts"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Dev Script (npm)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "bun",
      "name": "Bun: Run All Tests",
      "program": "${workspaceFolder}/tests/run.ts",
      "args": [],
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "bun",
      "name": "Bun: Run All Tests In Memory",
      "program": "${workspaceFolder}/tests/run.ts",
      "args": [
        "--memory"
      ],
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "bun",
      "name": "Bun: Debug Current Test File",
      "runtimeArgs": [
        "test",
        "--timeout",
        "30000"
      ],
      "program": "${file}",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "bun",
      "name": "Bun: Debug Selected Test",
      "runtimeArgs": [
        "test",
        "--timeout",
        "30000",
        "--test-name-pattern",
        "${selectedText}"
      ],
      "program": "${file}",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "bun",
      "name": "Bun: Watch Current Test File",
      "runtimeArgs": [
        "test",
        "--watch",
        "--timeout",
        "30000"
      ],
      "program": "${file}",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
